{
  "files.eol": "\n",
  "editor.tabSize": 2,
  "terminal.integrated.defaultProfile.linux": "caf (zsh)",
  "terminal.integrated.scrollback": 32000,
  "terminal.integrated.profiles.linux": {
    "caf (rover on docker)": {
      "path": "docker-compose",
      "args": [
        "-f",
        "rover_on_ssh_host.yml",
        "run",
        "-e",
        "ROVER_RUNNER=true",
        "--rm",
        "-w",
        "/tf/caf",
        "rover",
        "/bin/bash"
      ],
      "overrideName": true
    },
    "caf (zsh)": {
      "path": "zsh",
      "overrideName": true
    }
  },
  "peacock.remoteColor": "#215732",
  "[plaintext]": {
    "editor.quickSuggestionsDelay": 1
  },
  "markdown.validate.enabled": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#2f7c47",
    "activityBar.activeBorder": "#e7e7e7",
    "activityBar.background": "#2f7c47",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#422c74",
    "activityBarBadge.foreground": "#e7e7e7",
    "activityBarTop.activeBackground": "#2f7c47",
    "activityBarTop.activeBorder": "#e7e7e7",
    "activityBarTop.background": "#2f7c47",
    "activityBarTop.foreground": "#e7e7e7",
    "activityBarTop.inactiveForeground": "#e7e7e799",
    "commandCenter.border": "#e7e7e799",
    "commandCenter.foreground": "#e7e7e7",
    "sash.hoverBorder": "#2f7c47",
    "statusBar.background": "#215732",
    "statusBar.debuggingBackground": "#215732",
    "statusBar.debuggingForeground": "#e7e7e7",
    "statusBar.foreground": "#e7e7e7",
    "statusBar.inactiveBackground": "#215732",
    "statusBarItem.hoverBackground": "#2f7c47",
    "statusBarItem.remoteBackground": "#1b122e",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#215732",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#21573299",
    "titleBar.inactiveForeground": "#e7e7e799"
  },
  "peacock.color": "#215732"
}
